{
  "swagger": "2.0",
  "info": {
    "title": "Swagger with response example",
    "version": "1.0.0"
  },
  "paths": {
    "/example": {
      "get": {
        "summary": "Get example",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "message": "This is an example response"
              },
              "application/json-example-2": {
                "message": "This is another example response"
              }
            }
          }
        }
      }
    }
  }
}
